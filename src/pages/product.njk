                    <tr>
                        <td class="pt-5 pb-1 border-border border-b w-[120px] m576:w-[150px]">Заказ от 25 шт.</td>
                        <td class="pt-5 pb-1 border-border border-b font-bold">320 ₽</td>
                    </tr>
                    <tr>
                        <td class="pt-5 pb-1 border-border border-b w-[120px] m576:w-[150px]">Заказ от 35 шт.</td>
                        <td class="pt-5 pb-1 border-border border-b font-bold">290 ₽</td>
                    </tr>
                </table>
            </div>

            <div class="flex max-m768:flex-col m1024:flex-col gap-2.5">
                <div class="flex flex-wrap gap-2.5 m1024:mb-5">
