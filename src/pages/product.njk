{% extends 'layouts/main.njk' %}

{% block content %}

<div class="container">
    {% include '../src/components/breadcrumbs.njk' %}

    <section class="flex flex-wrap justify-between">
        <div class="w-[430px] h-[670px] bg-white rounded-[60px] overflow-hidden"></div>

        <div class="w-[430px] h-[670px] bg-white rounded-[60px] overflow-hidden flex-center">
            <img src="/src/assets/imgs/product/1.png" alt="" class="object-contain size-[80%]" />
        </div>

        <div class="w-[314px]">
            <span class="bg-accent text-white lowercase text-xs rounded-full px-1.5">новинка</span>

            <h1 class="mt-5 mb-2.5 font-bold text-[22px] leading-[26px] uppercase">
                крем для тела увлажняющий на основе черного тмина
            </h1>
            <p class="text-secondary text-xs mb-5">Артикул: 19000085435</p>

            <p class="mb-7 leading-8 text-[26px]">
                <span class="line-through">960</span>
                <span class="font-bold text-sale">690 ₽</span>
            </p>

            <div class="relative">
                <button class="absolute -top-9 right-0 bg-white size-[54px] rounded-full flex-center cursor-pointer">
                    <img src="/src/assets/imgs/icons/heart.svg" alt="" />
                </button>

                <h4 class="font-bold uppercase text-lg">Оптовая цена</h4>

                <table class="text-sm border-separate border-spacing-x-2.5 w-[calc(100%+20px)] -mx-2.5 mb-10">
                    <tr>
                        <td class="pt-5 pb-1 border-border border-b w-[150px]">Заказ до 15 шт.</td>
                        <td class="pt-5 pb-1 border-border border-b font-bold">390 ₽</td>
                    </tr>
                    <tr>
                        <td class="pt-5 pb-1 border-border border-b w-[150px]">Заказ от 15 шт.</td>
                        <td class="pt-5 pb-1 border-border border-b font-bold">360 ₽ ₽</td>
                    </tr>
                    <tr>
                        <td class="pt-5 pb-1 border-border border-b w-[150px]">Заказ от 25 шт.</td>
                        <td class="pt-5 pb-1 border-border border-b font-bold">320 ₽</td>
                    </tr>
                    <tr>
                        <td class="pt-5 pb-1 border-border border-b w-[150px]">Заказ от 35 шт.</td>
                        <td class="pt-5 pb-1 border-border border-b font-bold">290 ₽</td>
                    </tr>
                </table>
            </div>

            <div class="flex flex-wrap gap-2.5">
                <a href="#">
                    <img src="/src/assets/imgs/wb.svg" alt="" />
                </a>

                <a href="#">
                    <img src="/src/assets/imgs/ozon.svg" alt="" />
                </a>
            </div>
        </div>
    </section>

    <section class="flex flex-wrap justify-between mb-20 mt-[100px]">
        <div class="w-[430px]">
            <h4 class="font-bold uppercase text-lg">Характеристики</h4>

            <table class="text-sm border-separate border-spacing-x-2.5 w-[calc(100%+20px)] -mx-2.5">
                <tr>
                    <td class="pt-5 pb-1 border-border border-b w-[150px]">Тип продукта</td>
                    <td class="pt-5 pb-1 border-border border-b font-bold">Крем для тела</td>
                </tr>
                <tr>
                    <td class="pt-5 pb-1 border-border border-b w-[150px]">Для кого</td>
                    <td class="pt-5 pb-1 border-border border-b font-bold">Унисекс</td>
                </tr>
                <tr>
                    <td class="pt-5 pb-1 border-border border-b w-[150px]">Назначение</td>
                    <td class="pt-5 pb-1 border-border border-b font-bold">Восстановление, увлажнение</td>
                </tr>
                <tr>
                    <td class="pt-5 pb-1 border-border border-b w-[150px]">Тип кожи</td>
                    <td class="pt-5 pb-1 border-border border-b font-bold">Для всех типов кожи</td>
                </tr>
                <tr>
                    <td class="pt-5 pb-1 border-border border-b w-[150px]">Объём</td>
                    <td class="pt-5 pb-1 border-border border-b font-bold">250 мл</td>
                </tr>
                <tr>
                    <td class="pt-5 pb-1 border-border border-b w-[150px]">Область применения</td>
                    <td class="pt-5 pb-1 border-border border-b font-bold">Тело</td>
                </tr>
            </table>
        </div>

        <div class="w-[430px]">
            <h4 class="font-bold uppercase text-lg mb-[18px]">ОПИСАНИЕ</h4>

            <article>
                <p class="leading-5">
                    В этом креме есть все, чтобы восстановить и оздоровить клетки кожи. Восстанавливающий комплекс на основе черного тмина, экстракта берёзы, поддерживает барьерную функцию верхних слоев эпидермиса, дренирует, улучшает микроциркуляцию и обильно увлажняет.
                    <br/><br/>
                    • Восстанавливает микроциркуляцию
                    <br/><br/>
                    • Дренирует, выводит лишнюю жидкость
                    <br/><br/>
                    • Увлажняет
                    <br/><br/>
                    • Поддерживает правильный гидролипидный баланс
                </p>
            </article>
        </div>

        <div class="w-[314px]">
            <h4 class="font-bold uppercase text-lg mb-4">Доставка</h4>

            <p class="text-sm leading-4 mb-1">
                Бесплатная доставка товаров по России
                при покупке от 9 500 ₽
            </p>
            <a href="#" class="uppercase text-accent text-sm">Условия доставки</a>

            <h4 class="font-bold uppercase text-lg mb-4 mt-9">Состав</h4>
            <p class="text-sm leading-4">
                Aqua (Water), Isopropyl Myristate, Caprylic/Capric Triglyceride, Glycerin, Propylene Glycol, Fragrance, Glyceryl Stearate Citrate, C12-15 Alkyl Benzoate, Ceteareth-20, Cetyl Alcohol, Beeswax, Triethanolamine, Dmdm Hydantoin, Carbomer, Polysorbate 20, Phenoxyethanol, Ethylhexylglycerin, D-Limonene, Linallol, Citronellol, Coumarin, Geraniol, Citral
            </p>
        </div>
    </section>

    {% include '../src/components/products-slider.njk' %}
</div>

{% endblock %}
