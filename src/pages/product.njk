                        <svg width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.684 5.813H3.316a.562.562 0 0 0-.559.5l-1 9a.562.562 0 0 0 .56.624h13.367a.562.562 0 0 0 .56-.624l-1-9a.562.562 0 0 0-.56-.5Z" stroke="#fff" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.188 8.813v-4.5a2.813 2.813 0 0 1 5.625 0v4.5" stroke="#fff" stroke-linecap="round" stroke-linejoin="round"/></svg>
