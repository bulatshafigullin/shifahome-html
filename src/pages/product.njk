                </tr>
                <tr>
                    <td class="pt-5 pb-1 border-border border-b w-[120px] m576:w-[150px]">Для кого</td>
                    <td class="pt-5 pb-1 border-border border-b font-bold">Унисекс</td>
                </tr>
                <tr>
