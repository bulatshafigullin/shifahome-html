{% extends 'layouts/main.njk' %}

{% block content %}

<div class="container">
    {% include '../src/components/breadcrumbs.njk' %}

    <section class="grid grid-cols-1 m576:grid-cols-2 m1024:grid-cols-[1fr_1fr_314px] gap-5 m1024:gap-[56px] justify-between">
