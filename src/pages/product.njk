                </button>

                <h4 class="font-bold uppercase text-lg">Оптовая цена</h4>

                <table class="text-sm border-separate border-spacing-x-2.5 w-[calc(100%+20px)] -mx-2.5 mb-10">
                    <tr>
                        <td class="pt-5 pb-1 border-border border-b w-[120px] m576:w-[150px]">Заказ до 15 шт.</td>
                        <td class="pt-5 pb-1 border-border border-b font-bold">390 ₽</td>
                    </tr>
                    <tr>
                        <td class="pt-5 pb-1 border-border border-b w-[120px] m576:w-[150px]">Заказ от 15 шт.</td>
                        <td class="pt-5 pb-1 border-border border-b font-bold">360 ₽ ₽</td>
