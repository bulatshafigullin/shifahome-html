                </div>
            </div>

            <div class="rounded-[80px] overflow-hidden bg-white relative z-10">
                <img src="/src/assets/imgs/cooperation-vartiants/3.png" alt="" class="inset-0 absolute -z-10 object-cover" />

                <div class="p-10 pt-[118px] bg-main/60 hover:bg-main/90 text-white group transition-colors size-full flex flex-col justify-between">
                    <div>
                        <h4 class="font-bold uppercase text-3xl leading-[1.2] mb-[43px]">
                            Индивидуальная<br/>
                            разработка<br/>
                            средств
                        </h4>

                        <p class="leading-[1.4] mb-[39px]">
