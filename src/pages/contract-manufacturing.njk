    <section class="mb-[80px] grid grid-cols-2 gap-2.5">
        <div class="rounded-[80px] flex flex-col align-center items-center bg-white p-10 pt-[55px]">
            <h4 class="uppercase text-3xl leading-[1.2] mb-[29px]">
                Оставьте заявку<br/>
                на сотрудничество
            </h4>

            <form class="w-full flex flex-col items-center">
                <div class="grid grid-cols-2 gap-2.5 w-full">
                    <div class="relative rounded-2xl border border-border h-[68px] overflow-hidden">
                        <span class="absolute top-3 inset-x-[15px] text-sm leading-[1.2]">Ваше имя</span>

                        <input name="name" autocomplete="given-name" class="size-full pt-[34px] pb-2.5 px-[15px] placeholder:text-secondary leading-[1.2]" placeholder="Александр" />
                    </div>

                    <div class="relative rounded-2xl border border-border h-[68px] overflow-hidden">
                        <span class="absolute top-3 inset-x-[15px] text-sm leading-[1.2]">Ваша почта</span>

                        <input name="email" type="email" autocomplete="email" class="size-full pt-[34px] pb-2.5 px-[15px] placeholder:text-secondary leading-[1.2]" placeholder="name@mail.com" />
                    </div>

                    <div class="relative rounded-2xl border border-border h-[68px] overflow-hidden">
                        <span class="absolute top-3 inset-x-[15px] text-sm leading-[1.2]">Номер телефона</span>

                        <input name="phone" type="tel" autocomplete="tel" class="size-full pt-[34px] pb-2.5 px-[15px] placeholder:text-secondary leading-[1.2]" placeholder="+7" />
                    </div>

                    <div class="relative rounded-2xl border border-border h-[68px] overflow-hidden">
                        <span class="absolute top-3 inset-x-[15px] text-sm leading-[1.2]">Город</span>

                        <input name="city" autocomplete="address-level2" class="size-full pt-[34px] pb-2.5 px-[15px] placeholder:text-secondary leading-[1.2]" placeholder="Санкт-Петербург" />
                    </div>
                </div>

                <label class="my-[25px] inline-flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" class="hidden" />

                    <img src="/src/assets/imgs/icons/CheckSquare.svg" alt="" />

                    <span class="text-secondary text-xs leading-[1.2]">
                        Принимаю <a href="/privacy" class="underline" target="_blank" rel="noopener noreferrer">условия обработки</a> персональных данных
                    </span>
                </label>
            </form>

            <button class="button bg-accent w-[254px] text-white">
                <span>отправить заявку</span>

                <img src="/src/assets/imgs/icons/arrow-right.svg" alt="" />
            </button>
        </div>

        <img src="/src/assets/imgs/callback-img.png" alt="" class="object-cover rounded-[80px]" />
