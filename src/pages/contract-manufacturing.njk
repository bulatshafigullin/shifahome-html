            </div>

            <div class="w-[568px] py-[35px] px-10 bg-main text-white relative rounded-[60px] overflow-hidden col-span-full m1200:col-span-6">
                <p class="text-lg leading-[1.4] font-bold mb-10 m576:mb-[78px] uppercase">
