                    </div>

                    <button class="button border border-white group-hover:bg-accent group-hover:border-accent transition-all text-white w-[254px]">
                        <span>отправить заявку</span>

                        <img src="/src/assets/imgs/icons/arrow-right.svg" alt="" />
