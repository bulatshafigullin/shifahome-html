        <div class="w-[897px] flex flex-wrap justify-end gap-[15px] justify-self-end">
            <div class="w-[314px] py-[35px] px-10 bg-white relative rounded-[60px] overflow-hidden col-span-full m576:col-span-6 m1200:col-span-3">
                <p class="text-lg leading-[1.4] font-bold mb-10 m576:mb-[78px] uppercase">
                    Чистые составы<br/>
