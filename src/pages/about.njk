{% extends 'layouts/main.njk' %}

{% block content %}

<div class="container">
    {% include '../src/components/breadcrumbs.njk' %}

    <section class="m1024:aspect-[1286/460] relative rounded-[40px] m1024:rounded-[80px] overflow-hidden">
        <img class="object-cover -z-10 absolute size-full inset-0" src="/src/assets/imgs/about/about-bg.webp"
             alt="О бренде"/>

        <div class="gap-6 m1200:gap-16 bg-main/60 p-4 m1024:absolute inset-0 flex-center flex-col m768:py-8 m992:py-10 m1024:px-[153px] text-center text-white">
            <h1 class="text-2xl m992:text-3xl m1024:text-[40px] leading-[1.2] uppercase">
                Шифа Cosmetics — уходу за лицом<br class="max-m768:hidden" />
                и телом премиального качества
            </h1>
            <p>
                Сочетание новейших разработок в области косметологии, инновационных формул<br class="max-m768:hidden" />
                и эффективных решений для сохранения молодости и красоты.
            </p>
        </div>
    </section>

    <section class="my-20 m1200:my-40 flex items-start gap-y-4 gap-6 m1280:gap-x-[118px]">
        <div class="flex-1">
            <h3 class="uppercase text-2xl m992:text-3xl m1280:text-[44px] leading-[1.2] mb-8 m768:mb-[50px]">Главная цель</h3>

            <p class="text-base m992:text-xl leading-[1.3]">
                Главная цель компании Шифа Cosmetics
                – вывести косметологию на новый уровень, заложив новые стандарты
                в области ухода за кожей в соответствии
                с развитием научной мысли и постоянно возрастающими запросами косметологов и их пациентов.
                <br/><br/>
                Сегодня на новейшем европейском оборудовании мы производим
                до 20 000 средств ухода в день.
            </p>
        </div>

        <img class="max-m768:hidden w-4/12 m992:w-1/2 m1280:w-[746px] rounded-[60px]" src="/src/assets/imgs/about/1.webp" alt="Главная цель"/>
    </section>

    <section class="grid grid-cols-12 gap-2.5 mb-20 m1280:mb-[150px] leading-[1.4]">
        <div class="py-[35px] px-10 bg-white relative rounded-[60px] overflow-hidden col-span-full m576:col-span-6 m1200:col-span-3">
            <p class="text-lg leading-[1.4] font-bold mb-10 m576:mb-[78px] uppercase">
                Чистые составы<br/>
                и безупречные<br/>
                формулы
            </p>

            <p>Уход за кожей, волосами — всё собственного производства и только наивысшего качества</p>

            <img src="/src/assets/imgs/about/1.svg" class="absolute inset-y-0 right-0" alt="">
        </div>

        <div class="py-[35px] text-white px-10 bg-accent relative rounded-[60px] overflow-hidden col-span-full m576:col-span-6 m1200:col-span-3">
            <p class="text-lg leading-[1.4] font-bold mb-10 m576:mb-[78px] uppercase">
                Более 12 лет<br/>
                экспертного<br/>
                опыта
            </p>

            <p>Исследования, разработки и поиск лучших решений для здоровья и красоты</p>

            <img src="/src/assets/imgs/about/2.svg" class="absolute inset-y-0 right-0" alt="">
        </div>

        <div class="py-[35px] px-10 bg-white relative rounded-[60px] overflow-hidden col-span-full m1200:col-span-6">
            <p class="text-lg leading-[1.4] font-bold mb-10 m576:mb-[78px] uppercase">
                Строгий<br/>
                отбор всех<br/>
                ингредиентов
            </p>

            <p class="m576:w-5/12">В разработке каждого нашего продукта мы используем только самые проверенные ингредиенты.</p>

            <img src="/src/assets/imgs/about/hands.webp" class="max-m576:hidden absolute inset-y-0 h-full right-0" alt="">
        </div>
    </section>

    <section class="my-20 m1200:my-40 flex items-start gap-y-4 gap-6 m1280:gap-x-[118px]">
        <img class="max-m768:hidden w-4/12 m992:w-1/2 m1280:w-[746px] rounded-[60px]" src="/src/assets/imgs/about/2.webp" alt="Наше производство"/>

        <div class="flex-1">
            <h3 class="uppercase text-2xl m992:text-3xl m1280:text-[44px] leading-[1.2] mb-8 m768:mb-[50px">Наше производство</h3>
            <p class="text-base m992:text-xl leading-[1.3]">
                Руководство компании уделяет пристальное внимание эффективности выпускаемых средств, не забывая об их безопасности. Почти за два десятилетия работы процесс создания средств вобрал в себя все составляющие успеха: современную технологическую базу,
                штат высококвалифицированных специалистов, важнейшие научные разработки и экологически чистое сырье.
            </p>
        </div>
    </section>

    <div class="mb-20 m1200:mb-[140px]">
        {% include '../src/components/certificates-slider.njk' %}
    </div>

    <section class="flex gap-2.5">
        <img src="/src/assets/imgs/contract-production.webp" class="max-m992:hidden w-1/2 rounded-[32px] m1200:rounded-[80px] aspect-[638/460] object-cover" alt="Контрактное производство">

        <div class="text-white m992:aspect-[638/460] flex-1 bg-main flex-center rounded-[32px] m1200:rounded-[80px] flex-col p-4">
            <div class="flex-center flex-wrap gap-1.5 text-sm uppercase leading-[1.2]">
                <div class="flex items-center gap-3 py-2 pl-2 pr-4 bg-white/10 rounded-full">
                    <img src="/src/assets/imgs/icons/tick-circle.svg" alt="" class="size-4" />
                    <span>Брендинг</span>
                </div>
                <div class="flex items-center gap-3 py-2 pl-2 pr-4 bg-white/10 rounded-full">
                    <img src="/src/assets/imgs/icons/tick-circle.svg" alt="" class="size-4" />
                    <span>упаковка</span>
                </div>
                <div class="flex items-center gap-3 py-2 pl-2 pr-4 bg-white/10 rounded-full">
                    <img src="/src/assets/imgs/icons/tick-circle.svg" alt="" class="size-4" />
                    <span>доставка</span>
                </div>
            </div>

            <h4 class="mt-[42px] text-center uppercase mb-4 m1024:mb-[29px] text-3xl m1024:text-[40px] leading-[1.2]">
                Выгодное Контрактное производство
            </h4>

            <p class="mb-4 m1024:mb-11 text-center">Готовы произвести продукцию под ваш бренд и требования </p>

            <button class="button border-accent border w-[204px]">
                <span>Подробнее</span>

                <img src="/src/assets/imgs/icons/arrow-right.svg" alt="" />
            </button>
        </div>
    </section>
</div>

{% endblock %}
