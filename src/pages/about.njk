{% extends 'layouts/main.njk' %}

{% block content %}

<div class="container">
    {% include '../src/components/breadcrumbs.njk' %}

    <section class="aspect-[1286/460] relative rounded-[80px] overflow-hidden">
        <img class="object-cover -z-10 absolute size-full inset-0" src="/src/assets/imgs/about/about-bg.webp"
             alt="О бренде"/>

        <div class="bg-main/60 absolute inset-0 pt-[176px] px-[153px] text-center text-white">
            <h1 class="mb-16 text-[40px] leading-[1.2] uppercase">
                Шифа Cosmetics — уходу за лицом<br/>
                и телом премиального качества
            </h1>
            <p>
                Сочетание новейших разработок в области косметологии, инновационных формул<br/>
                и эффективных решений для сохранения молодости и красоты.
            </p>
        </div>
    </section>

    <section class="my-40 flex gap-y-4 gap-x-[118px]">
        <div class="flex-1">
            <h3 class="uppercase text-[44px] leading-[1.2] mb-[50px]">Главная цель</h3>
            <p class="text-xl leading-[1.3]">
                Главная цель компании Шифа Cosmetics
                – вывести косметологию на новый уровень, заложив новые стандарты
                в области ухода за кожей в соответствии
                с развитием научной мысли и постоянно возрастающими запросами косметологов и их пациентов.
                <br/><br/>
                Сегодня на новейшем европейском оборудовании мы производим
                до 20 000 средств ухода в день.
            </p>
        </div>

        <img class="w-[746px] rounded-[60px]" src="/src/assets/imgs/about/1.webp" alt="Главная цель"/>
    </section>

    <section class="flex gap-2.5 mb-[150px] leading-[1.4]">
        <div class="py-[35px] px-10 bg-white relative rounded-[60px] overflow-hidden w-3/12">
            <p class="text-lg leading-[1.4] font-bold mb-[78px] uppercase">
                Чистые составы<br/>
                и безупречные<br/>
                формулы
            </p>

            <p>Уход за кожей, волосами — всё собственного производства и только наивысшего качества</p>

            <img src="/src/assets/imgs/about/1.svg" class="absolute inset-y-0 right-0" alt="">
        </div>

        <div class="py-[35px] text-white px-10 bg-accent relative rounded-[60px] overflow-hidden w-3/12">
            <p class="text-lg leading-[1.4] font-bold mb-[78px] uppercase">
                Более 12 лет<br/>
                экспертного<br/>
                опыта
            </p>

            <p>Исследования, разработки и поиск лучших решений для здоровья и красоты</p>

            <img src="/src/assets/imgs/about/2.svg" class="absolute inset-y-0 right-0" alt="">
        </div>

        <div class="py-[35px] px-10 bg-white relative rounded-[60px] overflow-hidden w-6/12">
            <p class="text-lg leading-[1.4] font-bold mb-[78px] uppercase">
                Строгий<br/>
                отбор всех<br/>
                ингредиентов
            </p>

            <p class="w-5/12">В разработке каждого нашего продукта мы используем только самые проверенные ингредиенты.</p>

            <img src="/src/assets/imgs/about/hands.webp" class="absolute inset-y-0 h-full right-0" alt="">
        </div>
    </section>

    <section class="flex gap-y-4 gap-x-[118px] mb-[140px]">
        <img class="w-[746px] rounded-[60px]" src="/src/assets/imgs/about/2.webp" alt="Наше производство"/>

        <div class="flex-1">
            <h3 class="uppercase text-[44px] leading-[1.2] mb-[50px]">Наше производство</h3>
            <p class="text-xl leading-[1.3]">
                Руководство компании уделяет пристальное внимание эффективности выпускаемых средств, не забывая об их безопасности. Почти за два десятилетия работы процесс создания средств вобрал в себя все составляющие успеха: современную технологическую базу,
                штат высококвалифицированных специалистов, важнейшие научные разработки и экологически чистое сырье.
            </p>
        </div>
    </section>

    <section class="mb-[140px] product-slider-section relative docs-slider-section">
        <h4 class="text-2xl m768:text-3xl uppercase mb-[22px]">рекомендуем</h4>
        <p class="text-xl leading-[1.3]">Качество продукции подтверждено международными сертификатами</p>

        <div class="keen-slider products-slider mt-9">
            <div class="keen-slider__slide">
                <div class="aspect-[0.71/1] p-[5px] rounded-[20px] bg-white">
                    <img src="/src/assets/imgs/about/doc1.png" alt="" class="size-full object-cover" />
                </div>
            </div>
            <div class="keen-slider__slide">
                <div class="aspect-[0.71/1] p-[5px] rounded-[20px] bg-white">
                    <img src="/src/assets/imgs/about/doc1.png" alt="" class="size-full object-cover" />
                </div>
            </div>
            <div class="keen-slider__slide">
                <div class="aspect-[0.71/1] p-[5px] rounded-[20px] bg-white">
                    <img src="/src/assets/imgs/about/doc1.png" alt="" class="size-full object-cover" />
                </div>
            </div>
            <div class="keen-slider__slide">
                <div class="aspect-[0.71/1] p-[5px] rounded-[20px] bg-white">
                    <img src="/src/assets/imgs/about/doc1.png" alt="" class="size-full object-cover" />
                </div>
            </div>
            <div class="keen-slider__slide">
                <div class="aspect-[0.71/1] p-[5px] rounded-[20px] bg-white">
                    <img src="/src/assets/imgs/about/doc1.png" alt="" class="size-full object-cover" />
                </div>
            </div>
            <div class="keen-slider__slide">
                <div class="aspect-[0.71/1] p-[5px] rounded-[20px] bg-white">
                    <img src="/src/assets/imgs/about/doc1.png" alt="" class="size-full object-cover" />
                </div>
            </div>
            <div class="keen-slider__slide">
                <div class="aspect-[0.71/1] p-[5px] rounded-[20px] bg-white">
                    <img src="/src/assets/imgs/about/doc1.png" alt="" class="size-full object-cover" />
                </div>
            </div>
        </div>
    </section>

    <section class="flex gap-2.5">
        <img src="/src/assets/imgs/contract-production.webp" class="w-1/2 rounded-[80px] aspect-[638/460]" alt="Контрактное производство">

        <div class="text-white aspect-[638/460] bg-main flex-center rounded-[80px] flex-col p-4">
            <div class="flex-center flex-wrap gap-1.5 text-sm uppercase leading-[1.2]">
                <div class="flex items-center gap-3 py-2 pl-2 pr-4 bg-white/10 rounded-full">
                    <img src="/src/assets/imgs/icons/tick-circle.svg" alt="" class="size-4" />
                    <span>Брендинг</span>
                </div>
                <div class="flex items-center gap-3 py-2 pl-2 pr-4 bg-white/10 rounded-full">
                    <img src="/src/assets/imgs/icons/tick-circle.svg" alt="" class="size-4" />
                    <span>упаковка</span>
                </div>
                <div class="flex items-center gap-3 py-2 pl-2 pr-4 bg-white/10 rounded-full">
                    <img src="/src/assets/imgs/icons/tick-circle.svg" alt="" class="size-4" />
                    <span>доставка</span>
                </div>
            </div>

            <h4 class="mt-[42px] text-center uppercase mb-4 m1024:mb-[29px] text-3xl m1024:text-[40px] leading-[1.2]">
                Выгодное Контрактное производство
            </h4>

            <p class="mb-4 m1024:mb-11 text-center">Готовы произвести продукцию под ваш бренд и требования </p>

            <button class="button border-accent border w-[204px]">
                <span>Подробнее</span>

                <img src="/src/assets/imgs/icons/arrow-right.svg" alt="" />
            </button>
        </div>
    </section>
</div>

{% endblock %}
